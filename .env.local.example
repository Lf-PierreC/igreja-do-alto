# Copie este arquivo para ".env.local" na pasta "igreja-do-alto"
# Você encontra esses dois valores no painel do Supabase em:
# Project Settings (ícone de engrenagem) -> API

NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA-CHAVE-ANON-PUBLIC-AQUI"

